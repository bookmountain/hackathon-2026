{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  // Only used if you run the API outside Docker (e.g. from Rider/VS Code) — these point at the
  // Postgres/Redis *containers* via their published ports. Inside docker-compose, the api service
  // overrides them with Host=db / redis:6379.
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=unimap;Username=unimap;Password=unimap",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Key": "dev-only-signing-key-change-me-please-32+chars"
  }
}
