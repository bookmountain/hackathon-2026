# Copy to .env and adjust. Everything has a sensible default, so .env is optional for local dev.
POSTGRES_DB=unimap
POSTGRES_USER=unimap
POSTGRES_PASSWORD=unimap
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8080

JWT_KEY=dev-only-signing-key-change-me-please-32+chars

# Cloudflare R2 (optional — avatar upload endpoint returns 503 until these are set)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
