# Copy to .env and adjust. Everything has a sensible default, so .env is optional for local dev.
POSTGRES_DB=unimap
POSTGRES_USER=unimap
POSTGRES_PASSWORD=unimap
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8080

JWT_KEY=dev-only-signing-key-change-me-please-32+chars

# Cloudflare R2 (avatar upload endpoint returns 503 until keys are set).
# Keys: Cloudflare dashboard > R2 > Manage API tokens > Create token (Object Read & Write, this bucket).
R2_ACCOUNT_ID=b36c45b484aa3fdd762846963ca257a0
R2_BUCKET=hackathon-2026
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: public bucket URL (r2.dev or custom domain). Empty = API returns 24h presigned read URLs.
R2_PUBLIC_BASE_URL=

# Claude (Anthropic API), for photo analysis on the Sell and "List a room" forms and search by photo.
# Those endpoints return 503 until it's set. Key: platform.claude.com > API keys.
ANTHROPIC_API_KEY=
# Or a local vision model on Ollama, used instead of Claude when set (e.g. http://100.113.35.121:11434).
OLLAMA_BASE_URL=
OLLAMA_MODEL=qwen3-vl:8b-instruct

# Email. Empty SMTP_HOST = use the local Mailpit container (inbox at http://localhost:8025).
# Resend:  SMTP_HOST=smtp.resend.com SMTP_PORT=587 SMTP_USERNAME=resend SMTP_PASSWORD=re_xxx SMTP_SECURITY=auto
# Gmail:   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587 SMTP_USERNAME=you@gmail.com SMTP_PASSWORD=<app password> SMTP_SECURITY=auto
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURITY=
EMAIL_FROM=
